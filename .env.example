# Copy to .env for local development. On Render, add these under Environment.

# Claude AI — personalizes journey plans (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional: override the Claude model (default: claude-sonnet-5-5)
CLAUDE_MODEL=

# AeroDataBox via RapidAPI — live flight schedules, terminals and gates
# (https://rapidapi.com/aedbx-aedbx/api/aerodatabox)
RAPIDAPI_KEY=

# Secret for POST /api/model/train (send it in the X-Admin-Token header).
# Leave empty to disable retraining from the web.
ADMIN_TOKEN=

# Journey plans each visitor may request per hour (default 10)
JOURNEY_PLAN_LIMIT_PER_HOUR=10
